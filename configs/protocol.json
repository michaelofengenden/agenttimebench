  "recovery": {
    "preference": "continue_same_session_if_qualified",
    "fresh_replacement_limit_per_agent_task_arm": 1,
    "replacement_requires": [
      "confirmed_external_infrastructure_failure",
      "qualified_continuation_unavailable",
      "original_proven_stopped",
      "fresh_state_and_linked_new_attempt_id"
    ],
    "not_replacement_triggers": [
      "wrong_answer",
      "refusal",
      "voluntary_finish",
      "unknown_cause",
      "agent_caused_resource_exhaustion",
      "post_terminal_artifact_or_grade_loss"
    ],
    "continuation_clock": "preserve_elapsed_time_including_interruption",
    "replacement_counting": "separate_from_nominal_study_slots",
