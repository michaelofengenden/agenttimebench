{
  "schema_version": 1,
  "experiment": "AgentTime v1.1",
  "arms": [
    {
      "id": "natural",
      "natural_runtime_label": "M",
      "duration_request": null,
      "experiment_time_cap_seconds": null
    },
    {
      "id": "short",
      "factor_of_later_average": 0.25,
      "duration_seconds": null
    },
    {
      "id": "long",
      "factor_of_later_average": 4,
      "duration_seconds": null
    }
  ],
  "sequence": "collect_natural_first_then_calculate_timed_requests",
  "separate_timed_M": false,
